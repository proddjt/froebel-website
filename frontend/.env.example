# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for the Froebel website (Next.js + Payload + Supabase)
#
# There are two Supabase projects (https://supabase.com/dashboard):
#
#   froebel-payload-dev  → development and staging. Safe to break.
#                          Used by your local .env and by Vercel "Preview".
#   froebel-payload      → PRODUCTION, the live site.
#                          Used ONLY by Vercel "Production". Never put its
#                          values in a local .env.
#
# The dashboard paths below are the same in both projects: pick the right
# project first with the project switcher (top left).
#
# ── LOCAL DEVELOPMENT ────────────────────────────────────────────────────────
#   1. Copy this file to `frontend/.env` (git-ignored, never commit it).
#   2. Fill it in with froebel-payload-dev values (ask a maintainer for
#      access to the project, or for the values).
#   3. `npm install && npm run dev`, then open http://localhost:3000/admin
#
# ── VERCEL ───────────────────────────────────────────────────────────────────
#   Vercel → Project → Settings → Environment Variables.
#   Add every variable TWICE, ticking exactly one environment each time:
#     - Production → froebel-payload values      (deploys of `main`)
#     - Preview    → froebel-payload-dev values  (PRs and `vercel/staging`)
#   Never tick both for the same value. Redeploy after changing a variable.
#   Production deploys run `payload migrate` before building (vercel.json),
#   so the production database is only ever changed by committed migrations.
#
# Summary:
#   Variable                       local .env      Vercel Preview   Vercel Production
#   PAYLOAD_SECRET                 any             own value        own value
#   DATABASE_URL                   dev, Session    dev, Transaction prod, Transaction
#   DATABASE_PASSWORD              dev             dev              prod
#   NEXT_PUBLIC_SUPABASE_URL       dev             dev              prod
#   SUPABASE_STORAGE_BUCKET        media           media            media
#   SUPABASE_S3_REGION             dev             dev              prod
#   SUPABASE_S3_ACCESS_KEY_ID      dev key         dev key          prod key
#   SUPABASE_S3_SECRET_ACCESS_KEY  dev key         dev key          prod key
# ─────────────────────────────────────────────────────────────────────────────


# ── Payload ──────────────────────────────────────────────────────────────────

# Secret Payload uses to sign admin login tokens. Not from Supabase: generate
# a long random string with
#   openssl rand -hex 32
#   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Local: any value. Vercel: a different value for Preview and for Production.
# Changing it only logs everyone out of the admin panel.
PAYLOAD_SECRET=


# ── Database (Supabase Postgres) ─────────────────────────────────────────────

# Postgres connection string.
#   Where: Supabase → "Connect" button (top bar) → Connection string → URI.
#   Which one:
#     local .env          → "Session pooler"      (…pooler.supabase.com:5432)
#     Vercel (both envs)  → "Transaction pooler"  (…pooler.supabase.com:6543),
#                           made for serverless functions
#   Never use "Direct connection" (db.<ref>.supabase.co): it is IPv6-only and
#   fails on many home networks and on Vercel.
# Paste it as-is: the [YOUR-PASSWORD] placeholder is filled in from
# DATABASE_PASSWORD. (Or put the real password in the URL and leave
# DATABASE_PASSWORD empty.)
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# Database password, chosen when the Supabase project was created.
#   Where: Supabase doesn't show it again. Ask a maintainer, or reset it in
#   Project Settings → Database → "Reset database password" (resetting breaks
#   everything still using the old one, including Vercel).
DATABASE_PASSWORD=


# ── Supabase project ─────────────────────────────────────────────────────────

# Project URL, used for Storage and for loading images with next/image.
#   Where: Project Settings → Data API (or API) → Project URL.
#   Format: https://<project-ref>.supabase.co
# Needed at build time too.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co


# ── Supabase Storage (media uploads) ─────────────────────────────────────────
# Files uploaded in the admin panel are stored in Supabase Storage through its
# S3-compatible API. Locally the three SUPABASE_S3_* values may stay empty
# (uploads then go to the local disk). On Vercel they are REQUIRED, because
# Vercel can't keep files on disk.

# Bucket name. It must exist in the project and be marked "Public".
#   Where: Storage → Files → bucket list ("New bucket" to create it).
SUPABASE_STORAGE_BUCKET=media

# Region of the Supabase project, e.g. eu-west-1. The two projects may be in
# different regions, so check each one.
#   Where: Storage → S3 Configuration ("Region"), or the <region> part of the
#   pooler host in DATABASE_URL.
SUPABASE_S3_REGION=

# S3 access key pair.
#   Where: Storage → S3 Configuration → Access keys → "New access key".
#   The secret is shown only once: copy it immediately. Create separate keys
#   for separate people/places; a key can be revoked there at any time.
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=


# ── Set automatically, do not add ────────────────────────────────────────────
# VERCEL, VERCEL_TARGET_ENV  Set by Vercel on every deployment. Used to keep the
#                            DB pool small and to run migrations on Production only.
